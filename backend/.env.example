# Local dev — copy sang .env (gitignored). Production: GCP Secret Manager.
PORT=8080

# infra/docker-compose.yml
DATABASE_URL=postgresql://shotmate:shotmate@localhost:5432/shotmate
REDIS_URL=redis://localhost:6379

# Auth — JWT + magic link (spec FR-S3-1, Rule 6)
JWT_SECRET=change-me-local-only-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MAGIC_LINK_BASE_URL=https://shotmate.app/auth/verify
MAGIC_LINK_TTL_MINUTES=10

# Credits (spec FR-S3-4)
FREE_DAILY_QUOTA=10

# Cloud AI review (ADR-0004)
AI_REVIEW_PRIMARY=claude            # claude | gemini — Sprint 3: Remote Config
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_REVIEW_MODEL=claude-haiku-4-5
GEMINI_API_KEY=...
GEMINI_REVIEW_MODEL=gemini-2.5-flash

# Storage — signed URL upload (spec FR-S3-2). Local: minio (S3-compatible).
GCS_BUCKET=shotmate-photos-dev
STORAGE_ENDPOINT=http://localhost:9000   # bỏ trống = GCS thật (Sprint 3 deploy)
STORAGE_ACCESS_KEY=shotmate
STORAGE_SECRET_KEY=shotmate-local
STORAGE_REGION=auto
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760            # 10MB

# Email magic link (local: mailpit http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@shotmate.app

# Subscription (RevenueCat webhook — spec FR-S3-5)
REVENUECAT_WEBHOOK_SECRET=change-me-local-only
REVENUECAT_API_KEY=
